# Server-only settings for the inquiry form. Copy to .env.local (never commit real values).
# The form reports "not connected" until both Supabase variables are set.

# Supabase project URL.
SUPABASE_URL=https://bgjkjtfgrfiszbzatriq.supabase.co
# Supabase secret key (sb_secret_… or the legacy service_role key). Dashboard → Project Settings → API Keys.
# Never prefix with NEXT_PUBLIC_ and never commit the real value.
SUPABASE_SECRET_KEY=

# Optional canonical site URL for metadata and sitemap.
NEXT_PUBLIC_SITE_URL=https://landlordgopher.com
