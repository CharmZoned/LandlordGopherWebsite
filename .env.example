# Server-only settings for the inquiry form. Copy to .env.local (never commit real values).
# The form reports "not connected" until INQUIRY_WEBHOOK_URL is set.

# HTTPS endpoint that receives inquiries as JSON (CRM webhook, Zapier/Make hook, Formspree, etc.).
INQUIRY_WEBHOOK_URL=
# Optional shared secret, sent as "Authorization: Bearer <value>".
INQUIRY_WEBHOOK_SECRET=

# Optional canonical site URL for metadata and sitemap.
NEXT_PUBLIC_SITE_URL=https://landlordgopher.com
